
---
const services = [
  {
    number: "01",
    title: "Web Design & Development",
    description: "Fast, responsive websites designed to turn visitors into customers."
  },
  {
    number: "02",
    title: "Brand Identity",
    description: "Distinctive visual identities that make businesses memorable."
  },
  {
    number: "03",
    title: "Digital Strategy",
    description: "Clear digital experiences built around real business goals."
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Northstar Digital creates thoughtful websites, distinctive brands and digital experiences that help businesses grow." />
    <title>Northstar Digital — Design That Moves Business Forward</title>
  </head>

  <body>
    <header class="navbar">
      <a href="/" class="logo">northstar<span>.</span></a>

      <nav aria-label="Main navigation">
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#contact" class="nav-cta">Let's talk ↗</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">INDEPENDENT DIGITAL AGENCY · PERTH & BEYOND</p>

        <h1>
          Good design.<br />
          <span>Real impact.</span>
        </h1>

        <p class="hero-description">
          We build thoughtful digital experiences that help ambitious
          businesses stand out, connect and grow.
        </p>

        <div class="hero-actions">
          <a href="#contact" class="button-primary">Start a project ↗</a>
          <a href="#services" class="button-secondary">Explore our services ↓</a>
        </div>

        <div class="hero-bottom">
          <span>STRATEGY · DESIGN · DEVELOPMENT</span>
          <span>BUILT FOR WHAT'S NEXT.</span>
        </div>
      </section>

      <section id="services" class="services section">
        <p class="eyebrow">WHAT WE DO</p>
        <h2>Digital, with <span>intention.</span></h2>

        <div class="service-grid">
          {services.map((service) => (
            <article class="service-card">
              <span class="service-number">{service.number}</span>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <a href="#contact" aria-label={`Enquire about ${service.title}`}>
                Learn more ↗
              </a>
            </article>
          ))}
        </div>
      </section>

      <section id="about" class="about section">
        <p class="eyebrow">OUR APPROACH</p>
        <h2>We make digital feel <span>human.</span></h2>
        <p>
          Great digital work isn't just about looking good. It's about
          solving problems, making things easier and creating experiences
          people remember.
        </p>
      </section>

      <section id="contact" class="contact section">
        <p class="eyebrow">HAVE SOMETHING IN MIND?</p>
        <h2>Let's make it <span>happen.</span></h2>
        <a class="button-primary" href="mailto:hello@example.com">
          Tell us about your project ↗
        </a>
      </section>
    </main>

    <footer>
      <a href="/" class="logo">northstar<span>.</span></a>
      <p>© {new Date().getFullYear()} Northstar Digital. All rights reserved.</p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }

  :global(body) {
    margin: 0;
    background: #f8f8f5;
    color: #20221f;
    font-family: Arial, Helvetica, sans-serif;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .navbar {
    min-height: 82px;
    padding: 0 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e7e7e1;
  }

  .logo {
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -1.5px;
  }

  .logo span {
    color: #ed6845;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 30px;
    font-size: 14px;
  }

  .nav-cta {
    padding: 12px 18px;
    border: 1px solid #d7d7cf;
    border-radius: 30px;
  }

  .hero {
    min-height: 610px;
    padding: 110px 8% 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    color: #777970;
  }

  h1 {
    margin: 26px 0 20px;
    font-size: clamp(58px, 9vw, 112px);
    line-height: 0.98;
    letter-spacing: -7px;
  }

  h1 span,
  h2 span {
    color: #ed6845;
  }

  .hero-description {
    max-width: 490px;
    font-size: 18px;
    line-height: 1.7;
    color: #66685f;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 24px;
  }

  .button-primary,
  .button-secondary {
    display: inline-block;
    padding: 15px 21px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 700;
  }

  .button-primary {
    background: #20221f;
    color: white;
  }

  .button-primary:hover {
    background: #ed6845;
  }

  .button-secondary {
    border: 1px solid #d7d7cf;
  }

  .hero-bottom {
    width: 100%;
    margin-top: auto;
    padding-top: 65px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: #777970;
    font-size: 10px;
    letter-spacing: 1.2px;
  }

  .section {
    padding: 100px 8%;
  }

  .services {
    background: #efefe9;
  }

  h2 {
    margin: 18px 0 40px;
    font-size: clamp(36px, 5vw, 60px);
    letter-spacing: -2.5px;
    line-height: 1.1;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .service-card {
    min-height: 245px;
    padding: 25px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: #f8f8f5;
    border: 1px solid #e3e3dc;
    border-radius: 8px;
  }

  .service-number {
    color: #ed6845;
    font-size: 12px;
  }

  h3 {
    margin: 35px 0 10px;
    font-size: 21px;
    letter-spacing: -0.6px;
  }

  .service-card p,
  .about > p:last-child {
    color: #66685f;
    line-height: 1.7;
    font-size: 15px;
  }

  .service-card a {
    margin-top: auto;
    padding-top: 20px;
    font-size: 13px;
    font-weight: 700;
  }

  .about {
    max-width: 1000px;
  }

  .about > p:last-child {
    max-width: 600px;
    font-size: 18px;
  }

  .contact {
    background: #20221f;
    color: white;
  }

  .contact .eyebrow {
    color: #c2c3ba;
  }

  .contact h2 {
    margin-bottom: 30px;
  }

  footer {
    padding: 30px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  footer p {
    color: #777970;
    font-size: 12px;
  }

  @media (max-width: 700px) {
    .navbar {
      min-height: 72px;
      padding: 0 5%;
    }

    nav {
      gap: 14px;
      font-size: 12px;
    }

    .nav-cta {
      padding: 10px 12px;
    }

    .hero {
      min-height: 560px;
      padding: 90px 6% 25px;
    }

    h1 {
      letter-spacing: -3.5px;
    }

    .hero-description {
      font-size: 16px;
    }

    .hero-bottom {
      font-size: 9px;
      line-height: 1.7;
    }

    .section {
      padding: 75px 6%;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: 220px;
    }

    footer {
      padding: 25px 6%;
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 400px) {
    nav {
      gap: 10px;
    }

    nav a:first-child {
      display: none;
    }

    .hero-bottom {
      flex-direction: column;
    }
  }
</style>
